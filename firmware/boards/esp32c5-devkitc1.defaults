# Espressif ESP32-C5-DevKitC-1 (N8R8: 8 MB flash, 8 MB PSRAM).
CONFIG_IDF_TARGET="esp32c5"
CONFIG_NS_BOARD_ESP32C5_DEVKITC1=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions-8mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
# Skip the boot-time PSRAM test (about 2 s).
CONFIG_SPIRAM_MEMTEST=n
